libboost-locale1.83.0=1.83.0-4.2
dcmtk-data=3.6.9-5+deb13u3
libdcmtk19=3.6.9-5+deb13u3
libjsoncpp26=1.9.6-3
liblua5.3-0=5.3.6-2+b4
